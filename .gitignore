
# Ignore backup files
*/*~
*/*/*~
*/*/*/*~
.gitignore~

# Ignore directories for data/documentation/libraries.
data
doc
lib

# Include files generated by CMake
src/*/CMakeCache.txt
src/*/CMakeFiles
src/*/Makefile
src/*/cmake_install.cmake

# Ignore directories labeled Old
*/Old
*/*/Old

# Ignore any data files
src/*/*.off
src/*/*.ply
src/*/*.nrrd

# Ignore any files labeled garb or temp
src/*/garb*
src/*/temp*

# Ignore __pycache__
*/__pycache__
*/*/__pycache__
